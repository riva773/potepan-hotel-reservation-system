<% if flash[:notice] %>
  <div class="text-center fixed bottom-6 left-1/2 -translate-x-1/2 z-50">
    <div class="bg-black text-white inline-block py-2 px-4">
      <%= notice %>
    </div>
  </div>
<% end %>

<% if flash[:alert] %>
  <div class="text-center fixed bottom-6 left-1/2 -translate-x-1/2 z-50">
    <div class="bg-red-500 text-white inline-block py-2 px-4 rounded">
      <%= alert %>
    </div>
  </div>
<% end %>