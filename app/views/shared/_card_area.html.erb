<div>
  <%= link_to rooms_path(address: area_name), class: "relative aspect-[4/5] block" do %>
    <%= image_tag image_name, class: "rounded-xl object-cover cursor-pointer w-full h-full" %>
    <div class="absolute bottom-8 left-4">
      <h3 class="text-3xl text-white"><%= area_name %></h3>
      <h3 class="text-3xl text-white"><%= area_name_en %></h3>
    </div>
  <% end %>
</div>
