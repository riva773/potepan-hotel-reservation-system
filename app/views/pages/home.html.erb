<div>
  <div class="relative bg-cover bg-center w-full h-240 mb-40" style="background-image: url('<%= asset_path("main_visual.jpg") %>')">
    <h2 class="absolute top-1/3 left-1/2 -translate-x-1/2 -translate-y-1/2 text-7xl text-center text-white whitespace-nowrap leading-tight">Potepan Shareで<br>まだ体験したことのない<br>旅をしよう</h2>
    <div class="bg-white/40 absolute top-2/3 left-1/2 -translate-x-1/2 -translate-y-1/2 w-1/2 flex flex-col text-center p-8" >
      <%= form_with url: rooms_path, method: "get" do |f| %>
        <%= f.text_field :address, placeholder: "エリア名を入力", class: "bg-white p-4 mb-4 w-full" %>
        <%= f.submit "検索", class: "bg-orange-500 text-white rounded-xl p-4 w-full cursor-pointer" %>
      <% end %>

    </div>
  </div>
  <div class="px-6 mb-50">
    <h2 class="mb-30 text-3xl border-b-3 border-orange-500 pb-4 inline-block">おすすめのエリア</h2>
    <div class="grid grid-cols-4 gap-8 mb-10">
      <%= render "shared/card_area", area_name: "東京",area_name_en: "Tokyo", image_name: "tokyo.jpg" %>
      <%= render "shared/card_area", area_name: "大阪", area_name_en: "Osaka", image_name: "osaka.jpg" %>
      <%= render "shared/card_area", area_name: "京都", area_name_en: "Kyoto", image_name: "kyoto.jpg" %>
      <%= render "shared/card_area", area_name: "札幌", area_name_en: "Sapporo", image_name: "sapporo.jpg" %>
    </div>
  </div>
</div>
