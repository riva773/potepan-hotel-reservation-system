<% content_for :hide_footer, true %>

<div class="bg-gray-300 flex-1 flex justify-center items-center">
  <div class="bg-white w-1/3 mx-auto px-4 py-10">
    <h2 class="text-2xl text-center">新規登録</h2>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="field mb-2">
        <p><%= f.label :name, class: "text-sm font-bold text-gray-500" %></p>
        <p class="border p-2 rounded border-gray-300"><%= f.text_field :name, autofocus: true, autocomplete: "name", class: "w-full" %></p>
      </div>

      <div class="field mb-2">
        <p><%= f.label :email, class: "text-sm font-bold text-gray-500" %></p>
        <p class="border p-2 rounded border-gray-300"><%= f.email_field :email, autocomplete: "email", class: "w-full" %></p>
      </div>

      <div class="field mb-2">
        <p><%= f.label :password, class: "text-sm font-bold text-gray-500" %></p>
        <% if @minimum_password_length %>
          <p class="text-sm text-gray-500"><em>(<%= @minimum_password_length %> characters minimum)</em></p>
        <% end %>
        <p class="border p-2 rounded border-gray-300"><%= f.password_field :password, autocomplete: "new-password", class: "w-full" %></p>
      </div>

      <div class="field mb-2">
        <p><%= f.label :password_confirmation, class: "text-sm font-bold text-gray-500" %></p>
        <p class="border p-2 rounded border-gray-300"><%= f.password_field :password_confirmation, autocomplete: "new-password", class: "w-full" %></p>
      </div>

      <div class="actions mb-4">
        <%= f.submit "新しいアカウントを作成", class: "bg-orange-500 w-full text-center text-white font-bold rounded-xl p-4 cursor-pointer" %>
      </div>
    <% end %>

    <%= render "devise/shared/links" %>
  </div>
</div>
