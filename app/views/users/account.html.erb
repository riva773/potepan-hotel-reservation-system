<h2 class="mt-8 mb-4 w-3/4 mx-auto text-2xl">設定</h2>
<div class="w-3/4 mx-auto flex justify-between">
  <%= render "shared/side_bar" %>
  <div class="flex-1  mb-50">
    <div class="flex flex-1 justify-between border-b border-gray-300 mb-6">
        <h3 class="text-2xl pb-3">アカウント</h3>
        <%= link_to "編集", "#", class: "text-blue-500 text-xl" %>
    </div>
    <div class="grid grid-cols-[max-content_1fr] gap-x-20 gap-y-6">
      <p class="text-sm font-bold">メールアドレス</p>
      <p><%= @user.email %></p>
      <p class="text-sm font-bold">パスワード</p>
      <p class="text-sm"><%= "✴︎"*8 %></p>
    </div>
  </div>
</div>