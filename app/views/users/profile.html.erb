<h2 class="mt-8 mb-4 w-3/4 mx-auto text-2xl">設定</h2>
<div class="w-3/4 mx-auto flex justify-between">
  <%= render "shared/side_bar" %>
  <div class="flex-1  mb-50">
    <div class="flex flex-1 justify-between border-b border-gray-300 mb-6">
        <h3 class="text-2xl pb-3">プロフィール</h3>
        <%= link_to "編集", edit_users_profile_path, class: "text-blue-500 text-xl" %>
    </div>
    <div class="grid grid-cols-[max-content_1fr] gap-x-20 gap-y-6 items-center">
      <p class="text-sm font-bold">アイコン画像</p>
      <%= image_tag @user.avatar.attached? ? @user.avatar : "user_icon.png", class: "object-contain w-20 h-20" %>
      <p class="text-sm font-bold">名前</p>
      <%= @user.name %>
      <p class="text-sm font-bold">自己紹介</p>
      <%= @user.introduction %>
    </div>
  </div>
</div>